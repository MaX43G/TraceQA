# ============================================================
# 溯知 / TraceQA 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- LLM（硅基流动 OpenAI 兼容）----
# 后端 Spring AI base-url（不带 /v1，Spring AI 内部拼接 /v1/chat/completions）
LLM_BASE_URL=https://api.siliconflow.cn
LLM_API_KEY=please-change-me-in-production
# 默认问答模型
LLM_MODEL=THUDM/GLM-4-9B-0414

# ---- LightRAG 抽取模型与嵌入 ----
# LightRAG 的 LLM/Embedding base-url（需带 /v1）
LIGHTRAG_LLM_BASE_URL=https://api.siliconflow.cn/v1
LIGHTRAG_LLM_MODEL=THUDM/GLM-4-9B-0414
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=8192

# ---- LightRAG ----
LIGHTRAG_API_KEY=please-change-me-in-production
LIGHTRAG_TOP_K=20

# LightRAG并发参数控制。
LIGHTRAG_MAX_ASYNC_LLM=1
LIGHTRAG_MAX_ASYNC_EMBEDDING=1
LIGHTRAG_MAX_PARALLEL_INSERT=1

LIGHTRAG_TOKEN_EXPIRE_HOURS=48


# ---- MySQL（Docker 部署）----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=traceqa
MYSQL_USER=traceqa
MYSQL_PASSWORD=traceqa123

# ---- 安全 ----
APP_JWT_SECRET=please-change-me-in-production

# ---- 可观测性（Prometheus + Grafana，仅管理员可见）----
# Prometheus 抓取后端 /actuator/prometheus 所需的共享令牌
OBSERVABILITY_SCRAPE_TOKEN=traceqa-prometheus-scrape-change-me
# Grafana 已免登录（匿名 Admin，由后端代理鉴权兜底）；以下为兜底账号，一般无需使用
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123456

# ---- 应用 ----
APP_STORAGE_ROOT=./data/files

# 会话 Cookie 标记 Secure（仅当你部署 HTTPS 时设为 true）
APP_COOKIE_SECURE=false
