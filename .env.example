# ============================================================
# 溯知 / TraceQA 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- LLM（硅基流动 OpenAI 兼容）----
# 后端 Spring AI base-url（不带 /v1，Spring AI 内部拼接 /v1/chat/completions）
LLM_BASE_URL=https://api.siliconflow.cn
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 默认问答模型
LLM_MODEL=THUDM/GLM-4-32B-0414

# ---- LightRAG 抽取模型与嵌入 ----
# 抽取用轻量模型（限流宽松），嵌入用 bge-m3
# LightRAG 的 LLM/Embedding base-url（需带 /v1），默认与 LLM_BASE_URL 相同供应商
LIGHTRAG_LLM_BASE_URL=https://api.siliconflow.cn/v1
LIGHTRAG_LLM_MODEL=Qwen/Qwen3.5-4B
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=8192

# ---- LightRAG ----
# 鉴权密钥（必填，强烈建议改为强随机值，如 openssl rand -hex 32）。
# 一旦设置，LightRAG 所有 API 与 WebUI 都要求该 Key（请求头 X-API-Key，或 WebUI 登录）。
# 后端会自动携带该 Key 访问，外部调用方亦需携带。
LIGHTRAG_API_KEY=change-me-to-a-strong-random-key

# ---- LightRAG WebUI 账号鉴权（必配，否则 WebUI 以 Guest 打开、无法操作文档）----
# AUTH_ACCOUNTS 支持明文（admin:密码）或 bcrypt（admin:{bcrypt}$2b$12$...）。
# 生成 bcrypt 哈希：docker run --rm ghcr.io/hkuds/lightrag:latest lightrag-hash-password --username admin
LIGHTRAG_AUTH_ACCOUNTS=admin:change-me-password
# JWT 签名密钥（改强随机值）
LIGHTRAG_TOKEN_SECRET=change-me-to-a-strong-token-secret
# 登录态有效期（小时）
LIGHTRAG_TOKEN_EXPIRE_HOURS=48
LIGHTRAG_TOP_K=20
# 抽取并发（建议 2-4）：并发越高越快，但更容易触发硅基流动限流
LIGHTRAG_MAX_ASYNC_LLM=4
# 单次抽取并行提交的文档数（大文档多块时生效）
LIGHTRAG_MAX_PARALLEL_INSERT=2
# LLM 请求超时（秒）：默认 900s，小模型生成慢时放宽，避免抽取中途超时失败
LIGHTRAG_LLM_TIMEOUT=900
# Embedding 请求超时（秒）
LIGHTRAG_EMBEDDING_TIMEOUT=60
# 实体/关系抽取的单次 LLM 输出上限，防止无限输出触发超时
LIGHTRAG_LLM_MAX_OUTPUT_TOKENS=9000

# ---- MySQL（Docker 部署）----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=traceqa
MYSQL_USER=traceqa
MYSQL_PASSWORD=traceqa123

# ---- 安全 ----
APP_JWT_SECRET=please-change-me-in-production-2026

# ---- 应用 ----
APP_STORAGE_ROOT=./data/files
