# ============================================================
# 溯知 / TraceQA 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- LLM（硅基流动 OpenAI 兼容）----
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=THUDM/GLM-Z1-9B-0414

# ---- Embedding（供 LightRAG 使用）----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=8192

# ---- LightRAG ----
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TOP_K=20

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=traceqa
MYSQL_USER=traceqa
MYSQL_PASSWORD=traceqa123

# ---- 安全 ----
APP_JWT_SECRET=please-change-me-in-production-2026

# ---- 应用 ----
# 本地开发时后端上传文件存储目录
APP_STORAGE_ROOT=./data/files
