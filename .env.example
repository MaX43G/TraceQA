# ============================================================
# 溯知 / TraceQA 微服务环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- 基础设施 ----
# PostgreSQL
PG_ROOT_PASSWORD=root123456
PG_USER=traceqa
PG_PASSWORD=traceqa123

# Neo4j
NEO4J_AUTH=neo4j/traceqa-neo4j-2026

# Nacos 注册中心
NACOS_SERVER_ADDR=nacos:8848

# ---- LLM（硅基流动 OpenAI 兼容）----
# 问答服务 Spring AI base-url（不带 /v1）
LLM_BASE_URL=https://api.siliconflow.cn
LLM_API_KEY=please-change-me-in-production
# 默认问答模型
LLM_MODEL=THUDM/GLM-4-9B-0414

# ---- LightRAG 抽取模型与嵌入 ----
LIGHTRAG_LLM_BASE_URL=https://api.siliconflow.cn/v1
LIGHTRAG_LLM_MODEL=THUDM/GLM-4-9B-0414
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=8192
LIGHTRAG_API_KEY=please-change-me-in-production
LIGHTRAG_TOP_K=8
LIGHTRAG_MAX_ASYNC_LLM=1
LIGHTRAG_MAX_ASYNC_EMBEDDING=1
LIGHTRAG_MAX_PARALLEL_INSERT=1
LIGHTRAG_TOKEN_EXPIRE_HOURS=48

# ---- LightRAG 文本切分（P=段落语义切分，适合结构化 Markdown）----
LIGHTRAG_PROCESS_OPTIONS=P
LIGHTRAG_CHUNK_SIZE=1200
LIGHTRAG_CHUNK_OVERLAP=100
LIGHTRAG_CHUNK_P_SIZE=2000
LIGHTRAG_CHUNK_P_OVERLAP=100

# ---- 可观测性 ----
OBSERVABILITY_SCRAPE_TOKEN=traceqa-prometheus-scrape-change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123456
# 会话 Cookie 是否标记 Secure（HTTPS 部署设为 true，本地 HTTP 调试保持 false）
APP_COOKIE_SECURE=true

# ---- 安全 ----
# 默认账号密码（经环境变量注入，避免硬编码弱口令；生产务必修改）
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_USER_PASSWORD=user123456

# ---- 应用 ----
APP_STORAGE_ROOT=/app/data/files

# ---- 语义重排（Rerank）----
APP_RERANK_ENABLED=false
APP_RERANK_BASE_URL=
APP_RERANK_API_KEY=
APP_RERANK_MODEL=BAAI/bge-reranker-v2-m3
APP_RERANK_PATH=/rerank

# ---- MinIO 对象存储（统一管理用户上传文件，如头像）----
# 对外经 Caddy HTTPS 访问（S3 API 端口 6116）
MINIO_ENDPOINT=http://localhost:6116
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=please-change-me-in-production
MINIO_BUCKET=traceqa
# 头像等文件对外公开访问的地址
MINIO_PUBLIC_URL=https://YOUR_SERVER_IP