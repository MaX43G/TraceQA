  "panels": [
    {
      "title": "JVM 堆内存 (bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" },
        { "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})", "legendFormat": "committed" }
      ]
    },
    {
      "title": "HTTP 请求速率 (rps)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "legendFormat": "{{uri}}" }
      ]
    },
    {
      "title": "JVM 非堆内存 (bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\"}) by (id)", "legendFormat": "{{id}}" }
      ]
    },
    {
      "title": "HTTP 延迟 P95 (ms)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri)) * 1000", "legendFormat": "p95 {{uri}}" }
      ]
    },
    {
      "title": "活跃线程数",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "jvm_threads_live_threads", "legendFormat": "live" },
        { "expr": "jvm_threads_daemon_threads", "legendFormat": "daemon" },
        { "expr": "jvm_threads_peak_threads", "legendFormat": "peak" }
      ]
    },
    {
      "title": "GC 暂停速率 (ms/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "PROM" },
